# --- Telegram ---
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Random string you invent yourself (e.g. `openssl rand -hex 24`). Telegram
# echoes it back on every webhook call so we can verify the request really
# came from Telegram and not some random POST to your public Vercel URL.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string

# --- Supabase (Settings -> API in your Supabase project) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The "service_role" secret key (NOT the anon/public key) — required so the
# bot can write to tables regardless of Row Level Security policies.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Scraper targets ---
TARGET_URL=https://tickets.rfef.es/
YEEZY_TARGET_URL=https://yeezy.com

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=20

# Number of retries for transient network/5xx errors
MAX_RETRIES=3

# --- "Tickets are open" burst alert ---
# The moment ticket sales are detected as OPEN, subscribers get hammered
# with repeated alerts so it's impossible to miss: N messages back to back,
# then a pause, repeated for a total duration.
OPEN_ALERT_BURST_COUNT=10
OPEN_ALERT_BURST_INTERVAL_SECONDS=180
OPEN_ALERT_BURST_DURATION_SECONDS=3600
# Small delay between messages within one burst, to stay under Telegram's
# per-chat flood limits.
OPEN_ALERT_MESSAGE_DELAY_SECONDS=1.5

# --- Background check intervals (seconds) ---
# Used by the local-dev bot.py's asyncio background loops. In production
# these correspond to the cron schedules in .github/workflows/scrape_*.yml
# (GitHub Actions cron is static YAML, so if you change these values, also
# update the matching `cron:` line by hand).
SUPERCOPA_CHECK_INTERVAL=300
YEEZY_CHECK_INTERVAL=600
